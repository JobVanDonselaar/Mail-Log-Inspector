<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MailLogInspector</AssemblyName>
    <ApplicationIcon>Assets\MailLogInspector.ico</ApplicationIcon>
    <Version>0.223.0</Version>
    <AssemblyVersion>0.223.0.0</AssemblyVersion>
    <FileVersion>0.223.0.0</FileVersion>
    <InformationalVersion>0.223</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MailLogInspector.Core\MailLogInspector.Core.csproj" />
    <ProjectReference Include="..\MailLogInspector.Storage\MailLogInspector.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AdminSettings\**" />
    <EmbeddedResource Remove="AdminSettings\**" />
    <None Remove="AdminSettings\**" />
    <Page Remove="AdminSettings\**" />
  </ItemGroup>

</Project>
